  "comparison": {
    "option_a_database_triggers": {
      "name": "Database Triggers (RECOMMENDED)",
      "advantages": [
        "일관성: 모든 INSERT/UPDATE/DELETE 자동 캡처",
        "확장성: 새 기능 추가 시 코드 변경 불필요",
        "성능: 클라이언트 왕복 감소",
        "운영: 중복 로깅 방지, 권한 검증 DB에서 실행",
        "감사: Audit trail 자동 완성"
      ],
      "disadvantages": [
        "초기 개발: PL/pgSQL 학습 필요 (1-2시간)",
        "디버깅: Trigger silent failure 가능",
        "권한: DB 사용자 권한으로만 실행"
      ],
      "rls_consideration": {
        "issue": "activity_logs INSERT RLS 정책이 is_trip_editor_or_admin 필요",
        "solution": "Trigger는 SECURITY DEFINER로 RLS 우회 가능"
      },
      "implementation_effort": "3-4시간",
      "maintenance_burden": "낮음 (중앙화)"
    },
    "option_b_application_level": {
      "name": "Application-Level",
      "advantages": [
        "명시성: 어느 시점에 로그 기록되는지 명확",
        "유연성: 조건부 로깅 가능"
      ],
      "disadvantages": [
        "버그: 누락 위험 높음",
        "코드: 각 API route에 반복 코드",
        "권한: viewer 사용자 로그 기록 불가능",
        "비동기: 메인 응답과 분리되면 유실 가능"
      ],
      "implementation_effort": "낮음 (각 route마다 추가)",
      "maintenance_burden": "높음 (산재됨)"
    }
  },

